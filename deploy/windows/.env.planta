APP_NAME="Tuboformas"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# La URL fija del servidor en la red de la planta (la IP que deja instalar.ps1). Se usa en los enlaces de los correos.
APP_URL=http://192.168.1.250
APP_TIMEZONE=America/Guatemala
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tuboformas
DB_USERNAME=tuboformas
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=600
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# El correo se configura desde el sistema (Administración → Configuración → Correo).
# Estos valores solo se usan si allí no hay nada guardado.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@tuboformas.com"
MAIL_FROM_NAME="${APP_NAME}"

# Contraseña del usuario "admin" que se crea la primera vez. Cámbiala después en Mi perfil.
ADMIN_PASSWORD=
VITE_APP_NAME="${APP_NAME}"
